DATABASE_URL=postgresql+psycopg://workflow@127.0.0.1:54329/workflow
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_ISSUER=business-workflow-agent
JWT_AUDIENCE=business-workflow-api
KNOWLEDGE_BACKEND=deterministic_stub
REDIS_URL=redis://127.0.0.1:56379/0
# Default deterministic provider keeps tests and local startup reproducible.
PROVIDER_BACKEND=deterministic_stub
# Opt-in local Ollama example:
# PROVIDER_BACKEND=openai_compatible
# PROVIDER_BASE_URL=http://127.0.0.1:11434/v1
# PROVIDER_MODEL=qwen2.5:0.5b
# Remote providers may use a runtime secret reference; never commit the resolved value.
# PROVIDER_API_KEY=op://Private/business-workflow-agent/provider-api-key
# PROVIDER_TIMEOUT_SECONDS=30
# PROVIDER_MAX_ATTEMPTS=2
# Production enterprise-rag mode requires a server-side service token and an explicit
# tenant-to-knowledge-base mapping. Keep the token in 1Password or another secret store.
# KNOWLEDGE_BACKEND=enterprise_rag
# ENTERPRISE_RAG_BASE_URL=http://127.0.0.1:8010
# ENTERPRISE_RAG_BEARER_TOKEN=op://Private/enterprise-rag-service/token
# ENTERPRISE_RAG_KNOWLEDGE_BASE_IDS={"00000000-0000-0000-0000-000000000001":"00000000-0000-0000-0000-000000000002"}
